PORT=5000
MONGO_URI=mongodb://localhost:27017/authapp
# Must be at least 32 random characters
JWT_SECRET=REPLACE_WITH_32+_CHAR_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=15m
# Should differ from JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_32+_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development
